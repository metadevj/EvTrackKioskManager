<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access for CDN discovery + APK download. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service (dataSync) runs the download+install past the receiver's lifetime. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Resume an interrupted install after reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Show the ongoing FGS notification on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      NOTE: As Device Owner, silent install via PackageInstaller does NOT require
      REQUEST_INSTALL_PACKAGES / the "install unknown apps" user prompt.
    -->

    <!--
      Signature-level permission guarding the FrontDesk -> Manager install trigger.
      Only apps signed with the SAME key (evtrack-release) — i.e. FrontDesk — are
      granted it, so no other app can drive installs. FrontDesk <uses-permission> this.
    -->
    <permission
        android:name="com.evtrack.kioskmanager.permission.INSTALL_REQUEST"
        android:protectionLevel="signature" />

    <!--
      Android 11+ package visibility: without this, the Manager cannot see the
      managed app via PackageManager (getPackageInfo throws NameNotFound), so
      installedVersion()/isManagedInstalled() would wrongly report it absent and
      the bootstrap path would reinstall over an existing app.
    -->
    <queries>
        <package android:name="com.evtrack.frontdesk" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:testOnly="false"
        android:theme="@style/Theme.EvTrackKioskManager">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Device admin receiver. Required to hold Device Owner. Provision with:
            adb shell dpm set-device-owner com.evtrack.kioskmanager/.AdminReceiver
        -->
        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
          Receives PackageInstaller install/uninstall results. Not exported: it is
          targeted explicitly by component name in the IntentSender we pass to
          session.commit(), so it never needs to be reachable by other apps.
        -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <!--
          FrontDesk -> Manager install trigger. Exported so FrontDesk can reach it,
          but gated by our signature permission so ONLY same-signed apps can fire it.
        -->
        <receiver
            android:name=".ipc.InstallRequestReceiver"
            android:exported="true"
            android:permission="com.evtrack.kioskmanager.permission.INSTALL_REQUEST">
            <intent-filter>
                <action android:name="com.evtrack.kioskmanager.action.INSTALL" />
            </intent-filter>
        </receiver>

        <!-- Carries out the download + silent install in the foreground. -->
        <service
            android:name=".ipc.InstallService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          On boot: resume an interrupted install, and bootstrap the main app on a
          fresh device (installs latest from the CDN when the managed app is absent,
          since FrontDesk isn't there yet to trigger it).
        -->
        <receiver
            android:name=".ipc.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          QR / NFC Device Owner provisioning (Android 12+). The system calls these
          during enrollment to pick the management mode and confirm compliance.
          Not used by adb `dpm set-device-owner`. See issue #34.
        -->
        <activity
            android:name=".provisioning.GetProvisioningModeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".provisioning.PolicyComplianceActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>

</manifest>
