<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!--
          Content column: full width on narrow screens, but capped and centered on
          wide landscape screens (tablets / the RPi5 display) so the buttons don't
          stretch edge-to-edge.
        -->
        <LinearLayout
            android:id="@+id/contentColumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintWidth_max="560dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="22sp"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <!-- Status rows -->
            <TextView
                android:id="@+id/txtDeviceOwner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Device Owner: …"
                android:textSize="16sp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/txtNotOwnerHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B00020"
                android:textSize="13sp"
                android:visibility="gone"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/txtInstalled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Installed (com.evtrack.frontdesk): …"
                android:textSize="16sp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/txtNormalMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FrontDesk — Main (CDN): …"
                android:textSize="16sp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/txtNormalBeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FrontDesk — Beta (CDN): …"
                android:textSize="16sp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/txtEidaMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FrontDesk Eida — Main (CDN): …"
                android:textSize="16sp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/txtEidaBeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FrontDesk Eida — Beta (CDN): …"
                android:textSize="16sp"
                android:paddingBottom="12dp" />

            <!-- Actions -->
            <Button
                android:id="@+id/btnCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Check for update" />

            <Button
                android:id="@+id/btnNormalMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Install FrontDesk — Main" />

            <Button
                android:id="@+id/btnNormalBeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Install FrontDesk — Beta" />

            <Button
                android:id="@+id/btnEidaMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Install FrontDesk Eida — Main" />

            <Button
                android:id="@+id/btnEidaBeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Install FrontDesk Eida — Beta" />

            <Button
                android:id="@+id/btnRollback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rollback (last known good)" />

            <!--
              Maintenance only. Device Owner cannot be undone over adb, so without this a tablet
              can only be freed by a factory reset. Confirmed before it acts.
            -->
            <Button
                android:id="@+id/btnReleaseOwner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/release_device_owner" />

            <ProgressBar
                android:id="@+id/progressDownload"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="100"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Cancel"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:text="Ready." />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
