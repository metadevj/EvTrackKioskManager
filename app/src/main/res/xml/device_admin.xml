<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal, standard device admin policy set. Holding Device Owner (granted via
  `dpm set-device-owner`) is what actually enables silent PackageInstaller
  installs; these policies are the baseline admin capabilities.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <limit-password />
        <watch-login />
        <reset-password />
        <force-lock />
        <wipe-data />
        <set-global-proxy />
        <expire-password />
        <encrypted-storage />
        <disable-camera />
        <disable-keyguard-features />
    </uses-policies>
    <!--
      Required so the current Device Owner (FrontDesk) can hand ownership to this
      app in place via DevicePolicyManager.transferOwnership() — no factory reset.
      This is the migration path for already-provisioned devices (issue #33).
    -->
    <support-transfer-ownership />
</device-admin>
