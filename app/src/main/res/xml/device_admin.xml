<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal, standard device admin policy set. Holding Device Owner (granted via
  `dpm set-device-owner`) is what actually enables silent PackageInstaller
  installs; these policies are the baseline admin capabilities.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <limit-password />
        <watch-login />
        <reset-password />
        <force-lock />
        <wipe-data />
        <set-global-proxy />
        <expire-password />
        <encrypted-storage />
        <disable-camera />
        <disable-keyguard-features />
    </uses-policies>
</device-admin>
